# Depoii Next.js Application Environment Variables
# Configure these variables in your Vercel Project Settings -> Environment Variables

# Supabase Transaction Pooler URL (port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (port 5432) for running migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Engine Backend Selection: "supabase" (default) or "fastapi" (legacy proxy fallback)
ENGINE_BACKEND="supabase"

# Authentication & Admin Secrets
DEPOII_SESSION_SECRET="generate-a-random-32-byte-hex-string"
DEPOII_SUPERADMIN_EMAIL="admin@yourdomain.com"
DEPOII_SUPERADMIN_PASSWORD="your-secure-admin-password"
DEPOII_INVITE_CODE="pilot-only"

# Outbound Email / Notifications (Hostinger / SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="hello@yourdomain.com"
SMTP_PASS="your-smtp-password"
PILOT_NOTIFY_EMAIL="hello@yourdomain.com"
